# Copy to server/.env and fill in. server/.env is not committed.

# ── DeepSeek: writing, planning, revision, chat ───────────────────────────────
# REQUIRED for the writing service — secret
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# REQUIRED. There is no built-in default: a hardcoded name is only right until
# the provider retires it.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=180
DEEPSEEK_MAX_RETRIES=1

# Target length of a generated chapter, in words.
NEBIRU_CHAPTER_WORDS=1500

# ── ComfyUI: illustrations and covers ─────────────────────────────────────────
COMFYUI_URL=http://127.0.0.1:8188
# Checkpoint file name as ComfyUI lists it. BLANK = the first one it has installed.
COMFYUI_CHECKPOINT=
# Pixel size the checkpoint was trained at: 1024 for SDXL, 512 for SD 1.5.
COMFYUI_BASE_SIZE=1024
COMFYUI_STEPS=28
COMFYUI_CFG=6.5
COMFYUI_SAMPLER=dpmpp_2m
COMFYUI_SCHEDULER=karras
COMFYUI_TIMEOUT_SECONDS=300
# Optional: your own workflow, exported from ComfyUI with "Save (API Format)".
# Path is relative to the server folder. Put these tokens where values belong:
#   text:    %prompt%  %negative%  %checkpoint%  %sampler%  %scheduler%
#   numbers: "%seed%"  "%width%"  "%height%"  "%steps%"  "%cfg%"  (the whole value)
# BLANK = the built-in text-to-image workflow, which suits SD 1.5 and SDXL checkpoints.
COMFYUI_WORKFLOW=

# Where generated images are stored. BLANK = server/data
NEBIRU_DATA_DIR=

# Settings for running Nebiru with Docker. Copy to .env (./nebiru setup does
# this for you). .env is never committed.
#
# For development without Docker, see server/.env.example instead.

# ── Where Nebiru is reachable ─────────────────────────────────────────────────
NEBIRU_PORT=8787
# 127.0.0.1 = this machine only. Nebiru has no login of its own, so set
# 0.0.0.0 (reachable from the network) only behind something that adds one.
NEBIRU_BIND=127.0.0.1

# ── Where data is kept ────────────────────────────────────────────────────────
# Books, generated images and model files. Back up or move this one folder.
NEBIRU_DATA=./data
# Files in the data folder belong to this user (./nebiru setup fills these in).
PUID=1000
PGID=1000

# ── Writing: DeepSeek ─────────────────────────────────────────────────────────
# REQUIRED for writing features — secret
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# REQUIRED. No default is built in, so a retired model name is fixed here.
DEEPSEEK_MODEL=deepseek-flash
# Target length of a generated chapter, in words.
NEBIRU_CHAPTER_WORDS=1500

# ── Illustration: FLUX.1 Dev (quantized) in ComfyUI ───────────────────────────
# "art" runs the ComfyUI container, which needs an NVIDIA GPU and the NVIDIA
# Container Toolkit. Leave empty to run Nebiru without it; illustrations then
# use placeholder art.
COMPOSE_PROFILES=art

# Which quantization of FLUX.1 Dev to download and use. Smaller files need
# less GPU memory and lose a little detail. ./nebiru setup picks one from
# your GPU; change it any time and restart to fetch another.
#   Q4_K_S   6.8 GB   8 GB cards
#   Q5_K_S   8.3 GB   10-12 GB cards
#   Q6_K     9.9 GB   12-16 GB cards
#   Q8_0    12.7 GB   16 GB and up, closest to the original
FLUX_QUANT=Q5_K_S
# Text encoder: t5xxl_fp8_e4m3fn.safetensors (4.9 GB) or t5xxl_fp16.safetensors (9.8 GB).
FLUX_T5_FILE=t5xxl_fp8_e4m3fn.safetensors

FLUX_STEPS=24
FLUX_GUIDANCE=3.5
# Pixel size of the longer side's square equivalent; 1024 is FLUX's native size.
FLUX_SIZE=1024
# How long to wait for one picture before reporting a failure.
FLUX_TIMEOUT_SECONDS=600

# Extra ComfyUI flags. On a GPU shared with other services, use
#   --cache-none --reserve-vram 2
# so models are released after each picture and 2 GB of GPU memory is left alone.
COMFYUI_ARGS=
# Cap on ComfyUI's RAM, e.g. 8g. Empty = no cap.
COMFYUI_MEMORY_LIMIT=
# Download each model file from somewhere else (a mirror, your own server).
# Empty = the default source on Hugging Face.
FLUX_UNET_URL=
FLUX_T5_URL=
FLUX_CLIP_L_URL=
FLUX_VAE_URL=
# Only needed if a source requires a Hugging Face login.
HF_TOKEN=
# Set to 1 to supply the model files yourself under <data>/models.
NEBIRU_SKIP_MODEL_DOWNLOAD=

# ── Versions (change, then: docker compose up -d --build) ─────────────────────
COMFYUI_REF=v0.39.0
COMFYUI_GGUF_REF=6ea2651e7df66d7585f6ffee804b20e92fb38b8a
# PyTorch build. cu126 suits most NVIDIA drivers; RTX 50-series cards need cu130.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
